# Render + MongoDB Atlas + BotFather only.
# Set these in the Render dashboard. Do not commit real secrets.

MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/atf_airdrop
MONGODB_DB=atf_airdrop
BOT_TOKEN=123456:ABC-DEF
ADMIN_PASSWORD=change-me
WEBAPP_URL=https://YOUR-SERVICE.onrender.com
SESSION_SECRET=long-random-string
TELEGRAM_WEBHOOK_SECRET=long-random-string
NITRO_PRESET=render_com
NODE_VERSION=22
HOST=0.0.0.0

# Owner can add/remove admins. Admins cannot.
OWNER_TELEGRAM_ID=123456789
# Comma-separated extra admin Telegram IDs
ADMIN_TELEGRAM_IDS=

# Buy-level TON destination (defaults to the project owner address)
OWNER_TON_ADDRESS=UQCzzBp_io5zdMiOCMykYY7HzUFkhRqST-xMWvr_DzSScooi
# Optional USDT / DeFi destination — leave empty until you have it
OWNER_DEFI_ADDRESS=
# Optional ATF jetton master for on-chain holding sync
ATF_JETTON_ADDRESS=
# TON/USD used to prefill buy-level amount
TON_USD=5.5
# Optional Toncenter key for payment verification
TONCENTER_API_KEY=
